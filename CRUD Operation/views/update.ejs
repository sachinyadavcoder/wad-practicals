<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-full p-10 bg-zinc-900 text-white">
        <a class="text-blue-600" href="/read">Read Users</a>
        <h1 class="text-3xl mb-3 mt-5">Update user</h1> 
      <form action="/update" method="post">
        <input class="px-5 py-3 outline-none bg-transparent border-2 border-zinc-800 rounded-md" type="text" placeholder="Enter your name" name="name" value="<%= user.name %>">
        <input class="px-5 py-3 outline-none bg-transparent border-2 border-zinc-800 rounded-md" type="text" placeholder="Enter email" name="email" value="<%= user.email %>">
        <input class="px-5 py-3 outline-none bg-transparent border-2 border-zinc-800 rounded-md" type="text" placeholder="Enter your image" name="image" value="<%= user.image %>">
        <input type="hidden" name="id" value="<%= user._id %>">
        <input class="bg-yellow-600 border-2 rounded-md px-5 py-3 outline-none border-zinc-800" type="submit" value="Update User">
      </form>
      
    </div>
    
</body>
</html>