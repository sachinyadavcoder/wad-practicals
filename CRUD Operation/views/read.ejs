<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-full p-10 bg-zinc-900 text-white">
        <a class="text-blue-600" href="/">Go Back To Home</a>
        <h1 class="text-3xl mb-3 mt-5">All Users</h1>
      
    <div class="users flex flex-wrap gap-3">
        <% if (user.length>0) { %>
            
            <% user.forEach(user => { %>
                <div class="user w-60 bg-zinc-700 rounded-lg p-4">
                    <div class="img bg-red-400 w-full h-52 overflow-hidden rounded-lg">
                        <img class="w-full h-full object-cover object-top" src=<%= user.image%> onerror="this.src='/images/image.png';" alt="image">
                    </div>
                    <h3 class="text-xl mt-2"><%= user.name%></h3>
                    <h5 class="text-zinc-400 mb-2"><%=user.email%></h5>
                    <div class="flex justify-between px-2">
                        <a class="text-blue-500" href="/update/<%= user._id %>">Edit</a>
                        <a class="text-red-600" href="/delete/<%= user._id %>">Delete</a>
                    </div>
                </div>
                <%  }); %>
                <% } else { %>
                    <h1 class="text-2xl text-zinc-600"> No Users Found</h1>
                    <% } %>
        
        
    </div>
      
    </div>
    
</body>
</html>